#############################
# NRLAPP .gitignore
#############################

# Runtime uploads (ALDRI legg på GitHub)
wwwroot/uploads/

# Build output
bin/
obj/
dist/
publish/

# User-specific files
*.user
*.userosscache
*.suo

# Logs
*.log
logs/
log/

# Database files (SQLite etc.)
*.db
*.db-shm
*.db-wal

# Rider / ReSharper / IDEA
.idea/
*.iml
_ReSharper.Caches/

# VS Code & Visual Studio
.vscode/
.vs/

# NuGet packages
/packages/

# OS files
.DS_Store
Thumbs.db

# Docker
docker-compose.override.yml
docker-compose.*.yml
*.tar

# Node (in case React/JS pops in)
node_modules/

# Misc
*.cache
*.vsidx
*.v17
