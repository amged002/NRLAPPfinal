@{
    // Setter sidetittelen som brukes av layouten
    ViewData["Title"] = "Kontakt oss";
}

<section class="py-4">
    <header class="mb-4">
        <!-- Overskrift og introduksjonstekst -->
        <h1 class="display-6 fw-semibold">Kontakt oss</h1>
        <p class="fs-5 text-muted">
            Har du spørsmål om rapportering av luftfartshindre, bruk av løsningen
            eller Nasjonalt register over luftfartshindre (NRL)? Her finner du
            kontaktinformasjon for de mest vanlige henvendelsene.
        </p>
    </header>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4 p-md-5">
            <div class="row g-4">

                <!-- Generell kontaktinfo -->
                <div class="col-md-6">
                    <h4 class="mb-2">Generelle spørsmål om NRL</h4>
                    <p class="mb-1">
                        <strong>Telefon:</strong> 32 11 80 00<br />
                        <strong>E-post:</strong>
                        <a href="mailto:kundesenter@kartverket.no">kundesenter@kartverket.no</a>
                    </p>
                    <p class="text-muted mb-0">
                        For generelle spørsmål om registrering og regelverk.
                    </p>
                </div>

                <!-- Teknisk kontaktinfo -->
                <div class="col-md-6">
                    <h4 class="mb-2">Tekniske spørsmål og NRL-data</h4>
                    <p class="mb-1">
                        <strong>Telefon:</strong> 32 11 80 00<br />
                        <strong>E-post:</strong>
                        <a href="mailto:nrl@kartverket.no">nrl@kartverket.no</a>
                    </p>
                    <p class="text-muted mb-0">
                        For spørsmål om API-integrasjon og teknisk veiledning.
                    </p>
                </div>

                <!-- Postadresse til NRL -->
                <div class="col-md-6">
                    <h4 class="mt-3 mt-md-4 mb-2">Postadresse</h4>
                    <p class="mb-0">
                        Kartverket – Nasjonalt register over luftfartshindre<br />
                        3511 Hønefoss
                    </p>
                </div>

                <!-- Kontakt for feil i prototypen -->
                <div class="col-md-6">
                    <h4 class="mt-3 mt-md-4 mb-2">Feil i denne løsningen</h4>
                    <p class="mb-1">
                        <strong>E-post:</strong>
                        <a href="mailto:nrlapp-support@example.com">nrlapp-support@example.com</a>
                    </p>
                    <p class="text-muted mb-0">
                        For innmeldinger av feil i studentprototypen.
                    </p>
                </div>

            </div>
        </div>
    </div>

    <!-- Diskret note om informasjonskilde -->
    <p class="mt-3 text-muted small">
        Kontaktinformasjon for Nasjonalt register over luftfartshindre er basert på
        åpne opplysninger fra Kartverket.
    </p>
</section>
